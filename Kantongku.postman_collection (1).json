{
  "info": {
    "name": "Kantongku API",
    "description": "API untuk aplikasi manajemen dompet digital",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Get All Wallets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallets"]
            }
          }
        },
        {
          "name": "Create Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Makan\",\n  \"budget_limit\": 500000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallets",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallets"]
            }
          }
        },
        {
          "name": "Update Wallet",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Makan Updated\",\n  \"budget_limit\": 750000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallets/{{wallet_id}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallets", "{{wallet_id}}"]
            }
          }
        },
        {
          "name": "Delete Wallet",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/{{wallet_id}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallets", "{{wallet_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?wallet_id={{wallet_id}}&type=expense",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                {
                  "key": "wallet_id",
                  "value": "{{wallet_id}}"
                },
                {
                  "key": "type",
                  "value": "expense"
                }
              ]
            }
          }
        },
        {
          "name": "Create Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": {{wallet_id}},\n  \"amount\": 50000,\n  \"description\": \"Makan di restoran\",\n  \"type\": \"expense\",\n  \"transaction_date\": \"2026-05-13\",\n  \"image_url\": null,\n  \"is_ocr\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "Get Transaction Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transaction_id}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transaction_id}}"]
            }
          }
        },
        {
          "name": "Update Transaction",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 60000,\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transaction_id}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transaction_id}}"]
            }
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transaction_id}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transaction_id}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "description": "Base URL API server"
    },
    {
      "key": "token",
      "value": "",
      "description": "JWT token dari login endpoint"
    },
    {
      "key": "wallet_id",
      "value": "1",
      "description": "Wallet ID untuk testing"
    },
    {
      "key": "transaction_id",
      "value": "1",
      "description": "Transaction ID untuk testing"
    }
  ]
}
